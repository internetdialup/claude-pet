# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Local .app bundle produced by run.sh
build/

# Xcode
*.xcodeproj/
*.xcworkspace/
DerivedData/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Never commit anything captured from the operator's live Claude Code data.
# Transcripts and session files are private work product.
*.jsonl
scratch/
build/marketing/

# Operator-private docs and local Claude Code config — never tracked.
docs/internal/
/CLAUDE.md
/AGENT.md
.claude/

# Render output. The --render-* modes write wherever they are pointed, and the
# README points them at the repo root, so one `git add -A` after a render run
# would commit several MB of loose art. Root-anchored on purpose: the committed
# artwork under docs/media/ must stay tracked.
/*.png
/*.gif
/*.svg
/*.mp4
/*.beats.txt
/AppIcon.iconset/
/plate-*/
/out/
