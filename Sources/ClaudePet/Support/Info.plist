<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Claude Pet</string>
	<key>CFBundleExecutable</key>
	<string>ClaudePet</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Renamed from com.internetdialup.claude-pet 2026-08-31. That identity
	     is adoption-poisoned on macOS 26: the window server refuses to place
	     any status item created by an app wearing it — measured with minimal
	     probe apps, where the neighbouring id adopted in under three seconds
	     and this one parked its item off-screen forever, across reboots and
	     Control Center restarts, with no clearable record anywhere in
	     user-space. The sibling repo hit the identical disease and the rename
	     was the cure there too. The UserDefaults suite deliberately KEEPS the
	     old name (Preferences.suiteName) so every existing install's settings
	     survive; do not "tidy" the two into agreement. -->
	<key>CFBundleIdentifier</key>
	<string>com.internetdialup.clawd</string>
	<key>CFBundleName</key>
	<string>ClaudePet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.6.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
</dict>
</plist>
